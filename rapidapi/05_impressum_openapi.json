    "title": "German & DACH B2B Impressum, Contact & Legal Enricher (§ 5 DDG)",
    "description": "Crawls German and DACH business domains, resolves required § 5 DDG legal notices (Impressum), and extracts Managing Directors (Geschäftsführer/Vorstand), Commercial Register HRB numbers, court, and VAT IDs (USt-IdNr.).\n\nSynchronous API endpoint returning structured dataset items directly.",
    "version": "1.0.0",
    "contact": {
      "name": "Andre Grunert - Enterprise API Integrations",
      "url": "https://github.com/andregrunert-ctrl/german-b2b-data-suite"
    }
  },
  "servers": [
    {
      "url": "https://api.apify.com",
      "description": "Apify Production Cloud Gateway"
    }
  ],
  "security": [
    {
      "ApifyAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ApifyAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Apify API Token"
      }
    }
  },
  "paths": {
    "/v2/acts/AGrunert~german-impressum-b2b-lead-enricher/run-sync-get-dataset-items": {
      "post": {
        "tags": [
          "5. Impressum & CEO Enricher (§ 5 DDG)"
        ],
        "summary": "Enrich German corporate websites with CEO, legal entity, HRB and VAT ID",
        "description": "Crawls German and DACH business domains, resolves required § 5 DDG legal notices (Impressum), and extracts Managing Directors (Geschäftsführer/Vorstand), Commercial Register HRB numbers, court, and VAT IDs (USt-IdNr.).",
        "operationId": "run_impressum_sync",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "domains"
                ],
                "properties": {
                  "domains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of domains to enrich (e.g. ['personio.de', 'celonis.com'])"
                  },
                  "extract_contact_page": {
                    "type": "boolean",
                    "default": true,
                    "description": "Fallback scan of contact/about pages"
                  },
                  "max_concurrency": {
                    "type": "integer",
                    "default": 5,
                    "description": "Concurrent web workers"
                  }
                }
              },
              "example": {
                "domains": [
                  "personio.de",
                  "celonis.com"
                ],
                "extract_contact_page": true,
                "max_concurrency": 5
              }
            }
          }
        },
