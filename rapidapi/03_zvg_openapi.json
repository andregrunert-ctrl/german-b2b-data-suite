          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "states": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": [
                      "nw"
                    ],
                    "description": "German state codes (e.g. nw, by, be, bw, he, sn)"
                  },
                  "city": {
                    "type": "string",
                    "description": "City or court name filter"
                  },
                  "postal_code": {
                    "type": "string",
                    "description": "5-digit German postal code filter (e.g. 04109, 10115)"
                  },
                  "property_type": {
                    "type": "string",
                    "enum": [
                      "ALL",
                      "Eigentumswohnung",
                      "Einfamilienhaus",
                      "Mehrfamilienhaus",
                      "Doppelhaushälfte",
                      "Reihenhaus",
                      "Gewerbe",
                      "Grundstück",
                      "Garage"
                    ],
                    "default": "ALL",
                    "description": "Category of property"
                  },
                  "min_market_value": {
                    "type": "number",
                    "description": "Minimum property value in EUR"
                  },
                  "max_market_value": {
                    "type": "number",
                    "description": "Maximum property value in EUR"
                  },
                  "max_items": {
                    "type": "integer",
                    "default": 25,
                    "description": "Maximum auction records to return"
                  },
                  "include_details": {
                    "type": "boolean",
                    "default": true,
                    "description": "Fetch deep details including appraisal PDF links"
                  },
                  "include_cancelled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Include cancelled or revoked foreclosure notices"
                  }
                }
              },
              "example": {
                "states": [
                  "nw"
                ],
                "property_type": "Einfamilienhaus",
                "max_items": 10,
                "include_details": true
              }
            }
          }
        },
