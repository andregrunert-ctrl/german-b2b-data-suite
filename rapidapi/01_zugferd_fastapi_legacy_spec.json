    "/v1/invoice/validate": {
      "post": {
        "tags": [
          "1. Dokumenten-Engine"
        ],
        "summary": "4. ZUGFeRD / EN 16931 Validierung",
        "description": "Lade ein ZUGFeRD-PDF oder ein XML-Dokument hoch, um es auf Einhaltung der EN 16931 Norm zu prüfen.",
        "operationId": "validate_invoice_v1_invoice_validate_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_validate_invoice_v1_invoice_validate_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Validierung erfolgreich durchgeführt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResponse"
                },
                "examples": {
                  "valid_invoice": {
                    "summary": "1. Gültige E-Rechnung (EN 16931 konform)",
                    "value": {
                      "is_valid": true,
                      "format_detected": "PDF (ZUGFeRD / Factur-X EN 16931)",
                      "errors": []
                    }
                  },
                  "invalid_invoice": {
                    "summary": "2. Fehlerhafte E-Rechnung (Schema-Abweichung)",
                    "value": {
                      "is_valid": false,
                      "format_detected": "XML",
                      "errors": [
                        "Fehlender Knoten: ram:BuyerTradeParty (Käuferdaten fehlen).",
                        "Offizieller XSD-Schema-Fehler (EN 16931): Element 'ram:TaxBasisTotalAmount': This element is not expected."
                      ]
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Ungültiger Request (z. B. keine Datei im Feld 'file' übergeben)",
            "content": {
              "application/json": {
                "example": {
                  "detail": [
                    {
                      "loc": [
                        "body",
                        "file"
                      ],
                      "msg": "Field required (Bitte eine PDF- oder XML-Datei im Parameter 'file' anhängen)",
                      "type": "missing"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "API-Key ungültig oder fehlend",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Invalid or missing X-API-Key"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
