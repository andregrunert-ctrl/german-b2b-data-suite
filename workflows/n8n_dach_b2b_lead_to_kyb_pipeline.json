        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"search_terms\": [\"Elektroinstallation\", \"Photovoltaik\"],\n  \"locations\": [\"München\", \"Nürnberg\"],\n  \"max_items\": 10,\n  \"require_website\": true,\n  \"require_phone\": true\n}",
        "options": {
          "timeout": 120000
        }
      },
