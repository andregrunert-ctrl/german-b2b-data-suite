            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"company_name\": \"{{ $json.legal_company_name || $node['1. Apify: Scrape B2B Leads & Domains'].json.company_name }}\",\n  \"city\": \"{{ $json.city || $node['1. Apify: Scrape B2B Leads & Domains'].json.city }}\",\n  \"register_number\": \"{{ $json.register_number || '' }}\",\n  \"include_insolvency_check\": true,\n  \"include_financial_details\": true\n}",
        "options": {
          "timeout": 120000
        }
      },
